# Production environment for docker-compose.yml.
# Copy to .env on the server and fill in every CHANGE_ME. Never commit the real file.

APP_NAME="Property Center"
APP_ENV=production
# generate with:  docker compose run --rm app php artisan key:generate --show
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com
APP_DOMAIN=CHANGE_ME.example.com
APP_FORCE_HTTPS=true
# Caddy is the only thing in front of the app, so trusting its X-Forwarded-* headers is correct
TRUSTED_PROXIES=*
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- database (the same values create the MySQL container) ----
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=property_center
DB_USERNAME=property_center
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ---- sessions / cache / queue ----
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- mail (password-reset links). Use any SMTP provider ----
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
# smtp = STARTTLS (port 587), smtps = implicit TLS (port 465)
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@CHANGE_ME.example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- optional ----
# Expo "enhanced push security" access token (only if enabled for your Expo project)
EXPO_ACCESS_TOKEN=
# Social login (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=
