# Caddy terminates TLS and obtains/renews Let's Encrypt certificates automatically.
# APP_DOMAIN must be a real domain whose DNS A record points at this server,
# and ports 80 + 443 must be open. With APP_DOMAIN=localhost it uses a local test CA.
{$APP_DOMAIN:localhost} {
    encode zstd gzip

    # large enough for a multi-photo listing upload
    request_body {
        max_size 32MB
    }

    reverse_proxy app:80
}
